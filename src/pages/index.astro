---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const publishedPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = publishedPosts.filter((post) => post.data.featured === true);
const latestPosts = publishedPosts.slice(0, 4);

---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-copy">
					<h1>你好，欢迎来到我的小世界。</h1>
					<p class="hero-en">WELCOME TO MY LITTLE WORLD</p>
					<p class="hero-intro">记录生活、分享灵感，也收藏那些值得记住的小事。</p>
					<p class="hero-assist">Little moments, lovely memories.</p>
				</div>
				<div class="hero-art" aria-hidden="true">
					<div class="petal petal-one"></div>
					<div class="petal petal-two"></div>
					<div class="petal petal-three"></div>
					<svg class="hero-illustration" viewBox="0 0 280 240" fill="none" xmlns="http://www.w3.org/2000/svg">
						<ellipse cx="140" cy="210" rx="86" ry="14" fill="var(--warm-soft)" opacity="0.7"></ellipse>
						<circle cx="52" cy="48" r="10" fill="var(--accent-soft)"></circle>
						<circle cx="230" cy="36" r="8" fill="var(--warm-soft)"></circle>
						<circle cx="214" cy="72" r="5" fill="var(--accent-soft)"></circle>
						<path d="M92 86c-18 8-28 32-18 52 8 16 28 24 48 22" stroke="var(--accent)" stroke-width="3" fill="none"></path>
						<path
							d="M168 78c22-18 48-8 54 16 4 16-4 34-22 42"
							stroke="var(--accent)"
							stroke-width="3"
							fill="none"
						></path>
						<ellipse cx="140" cy="148" rx="58" ry="46" fill="var(--surface)"></ellipse>
						<ellipse cx="140" cy="154" rx="50" ry="38" fill="var(--page-bg)"></ellipse>
						<ellipse cx="108" cy="78" rx="18" ry="24" fill="var(--surface)" transform="rotate(-18 108 78)"></ellipse>
						<ellipse cx="172" cy="78" rx="18" ry="24" fill="var(--surface)" transform="rotate(18 172 78)"></ellipse>
						<ellipse cx="108" cy="80" rx="10" ry="14" fill="var(--accent-soft)" transform="rotate(-18 108 80)"></ellipse>
						<ellipse cx="172" cy="80" rx="10" ry="14" fill="var(--accent-soft)" transform="rotate(18 172 80)"></ellipse>
						<circle cx="140" cy="108" r="38" fill="var(--surface)"></circle>
						<circle cx="126" cy="108" r="4.5" fill="var(--text-primary)"></circle>
						<circle cx="154" cy="108" r="4.5" fill="var(--text-primary)"></circle>
						<circle cx="128" cy="106.5" r="1.4" fill="var(--surface)"></circle>
						<circle cx="156" cy="106.5" r="1.4" fill="var(--surface)"></circle>
						<path d="M140 114c2.4 3 6.4 3 8 0" stroke="var(--text-english)" stroke-width="2" stroke-linecap="round"></path>
						<path d="M140 114c-2.4 3-6.4 3-8 0" stroke="var(--text-english)" stroke-width="2" stroke-linecap="round"></path>
						<path d="M118 116h-16M118 120h-14M162 116h16M162 120h14" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"></path>
						<circle cx="116" cy="116" r="5" fill="var(--accent-soft)" opacity="0.85"></circle>
						<circle cx="164" cy="116" r="5" fill="var(--accent-soft)" opacity="0.85"></circle>
						<path d="M96 168c18 18 70 18 88 0" stroke="var(--warm-soft)" stroke-width="8" stroke-linecap="round"></path>
					</svg>
				</div>
			</section>

			<section class="featured" aria-labelledby="featured-title">
				<div class="section-heading">
					<h2 id="featured-title">精选文章</h2>
					<p class="section-en">FEATURED STORIES</p>
				</div>
				{featuredPosts.length > 0 ? (
					<ul class="post-grid">
						{featuredPosts.map((post, index) => (
							<li>
								<PostCard post={post} variant={index} fallbackToPastel />
							</li>
						))}
					</ul>
				) : (
					<div class="featured-empty" role="status">
						<p>精选文章稍后揭晓。</p>
						<p>Featured stories are coming soon.</p>
					</div>
				)}
			</section>

			<section class="home-about" aria-labelledby="home-about-title">
				<div class="home-about-copy">
					<p class="section-en">ABOUT ME</p>
					<h2 id="home-about-title">{profile.displayName}</h2>
					<p>{profile.introduction}</p>
					<p class="home-about-en">{profile.introductionEn}</p>
					<a href="/about/">关于我 <span>READ MORE</span></a>
				</div>
				<div class="currently" aria-labelledby="currently-title">
					<div class="section-heading">
						<h2 id="currently-title">最近在做</h2>
						<p class="section-en">CURRENTLY</p>
					</div>
					<dl class="currently-list">
						{profile.currently.map((item) => (
							<div>
								<dt>{item.label}<span>{item.english}</span></dt>
								<dd>{item.value}</dd>
							</div>
						))}
					</dl>
				</div>
			</section>

			<section class="latest">
				<div class="section-heading">
					<h2>最新文章</h2>
					<p class="section-en">LATEST NOTES</p>
				</div>
				{latestPosts.length > 0 && (
				<ul class="post-grid">
					{latestPosts.map((post, index) => (
						<li>
							<PostCard post={post} variant={index} fallbackToPastel />
						</li>
					))}
				</ul>
				)}
				{latestPosts.length === 0 && (
					<div class="empty-posts" role="status">
						<p>目前还没有正式发布的文章，欢迎稍后再来看看。</p>
						<p>No published posts yet. Please check back soon.</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: var(--site-width);
		max-width: calc(100% - 2em);
		padding-top: 2.4rem;
		padding-bottom: 4rem;
	}

	.hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: var(--space-8);
		align-items: center;
		padding: var(--space-8);
		background: var(--surface);
		border-radius: var(--radius-feature);
		box-shadow: var(--box-shadow);
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: auto -40px -50px auto;
		width: 220px;
		height: 220px;
		background: radial-gradient(circle, var(--warm-soft) 0%, transparent 70%);
		pointer-events: none;
	}

	.hero-copy h1 {
		margin: 0;
		font-size: var(--font-size-display);
		line-height: 1.35;
		color: var(--text-primary);
	}

	.hero-en {
		margin: 0.55rem 0 1.15rem;
		font-size: var(--font-size-caption);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-english);
	}

	.hero-intro {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.8;
		max-width: 28rem;
	}

	.hero-assist {
		margin: 0.4rem 0 0;
		font-size: var(--font-size-caption);
		color: var(--text-english);
	}

	.hero-art {
		position: relative;
		min-height: 240px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(160deg, var(--accent-soft) 0%, var(--surface) 48%, var(--sage-soft) 100%);
		border-radius: var(--radius-feature);
	}

	.hero-illustration {
		width: min(280px, 100%);
		height: auto;
		position: relative;
		z-index: 1;
	}

	.petal {
		position: absolute;
		width: 14px;
		height: 18px;
		background: var(--accent-soft);
		border-radius: 70% 10% 70% 10%;
		opacity: 0.9;
	}

	.petal-one {
		top: 18px;
		left: 22px;
		transform: rotate(18deg);
	}

	.petal-two {
		top: 42px;
		right: 28px;
		background: var(--warm-soft);
		transform: rotate(-24deg);
	}

	.petal-three {
		bottom: 28px;
		left: 42px;
		transform: rotate(40deg);
	}

	.latest {
		margin-top: var(--space-12);
	}

	.featured {
		margin-top: var(--space-12);
	}

	.featured-empty {
		padding: var(--space-5) 0;
		border-top: 1px solid var(--divider);
		border-bottom: 1px solid var(--divider);
		color: var(--text-secondary);
	}

	.featured-empty p {
		margin: 0;
	}

	.featured-empty p + p {
		margin-top: var(--space-1);
		color: var(--text-english);
		font-size: var(--font-size-small);
	}

	.home-about {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: var(--space-12);
		margin-top: var(--space-12);
		padding: var(--space-8) 0;
		border-top: 1px solid var(--divider);
		border-bottom: 1px solid var(--divider);
	}

	.home-about-copy h2 {
		margin: 0 0 var(--space-3);
		font-size: var(--font-size-display);
		font-weight: var(--font-weight-semibold);
	}

	.home-about-copy > p:not(.section-en) {
		margin: 0 0 var(--space-2);
		color: var(--text-primary);
	}

	.home-about-copy .home-about-en {
		color: var(--text-english);
		font-size: var(--font-size-small);
	}

	.home-about-copy > a {
		display: inline-flex;
		gap: var(--space-2);
		margin-top: var(--space-3);
		color: var(--accent-dark);
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}

	.home-about-copy > a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.currently .section-heading {
		margin-bottom: var(--space-4);
	}

	.currently-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4);
		margin: 0;
	}

	.currently-list > div {
		padding-top: var(--space-3);
		border-top: 1px solid var(--divider);
	}

	.currently-list dt {
		color: var(--text-primary);
		font-weight: var(--font-weight-semibold);
	}

	.currently-list dt span {
		display: block;
		margin-top: var(--space-1);
		color: var(--text-english);
		font-size: var(--font-size-caption);
		font-weight: 400;
	}

	.currently-list dd {
		margin: var(--space-2) 0 0;
		color: var(--text-secondary);
		font-size: var(--font-size-small);
	}

	.empty-posts {
		padding: var(--space-6) var(--space-4);
		border-radius: var(--radius-card);
		background: var(--surface);
		box-shadow: var(--box-shadow);
		text-align: center;
	}

	.empty-posts p {
		margin: 0;
	}

	.empty-posts p + p {
		margin-top: 0.25rem;
		font-size: var(--font-size-caption);
		color: var(--text-english);
	}

	.section-heading {
		margin-bottom: var(--space-5);
	}

	.section-heading h2 {
		margin: 0;
		font-size: var(--font-size-page-title);
		color: var(--text-primary);
	}

	.section-en {
		margin: 0.3rem 0 0;
		font-size: var(--font-size-caption);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-english);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-5);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 1.5rem 1.25rem 1.4rem;
		}

		.hero-copy h1 {
			font-size: var(--font-size-page-title);
		}

		.post-grid {
			grid-template-columns: 1fr;
		}

		.home-about {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}
	}

	@media (max-width: 720px) {
		.home {
			padding-top: 1.4rem;
		}

		.hero-art {
			min-height: 200px;
		}

		.currently-list {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
	}
</style>
