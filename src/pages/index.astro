---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-copy">
					<h1>你好，欢迎来到我的小世界。</h1>
					<p class="hero-en">WELCOME TO MY LITTLE WORLD</p>
					<p class="hero-intro">记录生活、分享灵感，也收藏那些值得记住的小事。</p>
					<p class="hero-assist">Little moments, lovely memories.</p>
				</div>
				<div class="hero-art" aria-hidden="true">
					<div class="petal petal-one"></div>
					<div class="petal petal-two"></div>
					<div class="petal petal-three"></div>
					<svg class="hero-illustration" viewBox="0 0 280 240" fill="none" xmlns="http://www.w3.org/2000/svg">
						<ellipse cx="140" cy="210" rx="86" ry="14" fill="#E9E1F3" opacity="0.7"></ellipse>
						<circle cx="52" cy="48" r="10" fill="#F5DCE5"></circle>
						<circle cx="230" cy="36" r="8" fill="#E9E1F3"></circle>
						<circle cx="214" cy="72" r="5" fill="#F5DCE5"></circle>
						<path d="M92 86c-18 8-28 32-18 52 8 16 28 24 48 22" stroke="#D9B8C4" stroke-width="3" fill="none"></path>
						<path
							d="M168 78c22-18 48-8 54 16 4 16-4 34-22 42"
							stroke="#D9B8C4"
							stroke-width="3"
							fill="none"
						></path>
						<ellipse cx="140" cy="148" rx="58" ry="46" fill="#FFFDF9"></ellipse>
						<ellipse cx="140" cy="154" rx="50" ry="38" fill="#F8F3EC"></ellipse>
						<ellipse cx="108" cy="78" rx="18" ry="24" fill="#FFFDF9" transform="rotate(-18 108 78)"></ellipse>
						<ellipse cx="172" cy="78" rx="18" ry="24" fill="#FFFDF9" transform="rotate(18 172 78)"></ellipse>
						<ellipse cx="108" cy="80" rx="10" ry="14" fill="#F5DCE5" transform="rotate(-18 108 80)"></ellipse>
						<ellipse cx="172" cy="80" rx="10" ry="14" fill="#F5DCE5" transform="rotate(18 172 80)"></ellipse>
						<circle cx="140" cy="108" r="38" fill="#FFFDF9"></circle>
						<circle cx="126" cy="108" r="4.5" fill="#62544F"></circle>
						<circle cx="154" cy="108" r="4.5" fill="#62544F"></circle>
						<circle cx="128" cy="106.5" r="1.4" fill="#FFFDF9"></circle>
						<circle cx="156" cy="106.5" r="1.4" fill="#FFFDF9"></circle>
						<path d="M140 114c2.4 3 6.4 3 8 0" stroke="#A58C91" stroke-width="2" stroke-linecap="round"></path>
						<path d="M140 114c-2.4 3-6.4 3-8 0" stroke="#A58C91" stroke-width="2" stroke-linecap="round"></path>
						<path d="M118 116h-16M118 120h-14M162 116h16M162 120h14" stroke="#D9B8C4" stroke-width="2" stroke-linecap="round"></path>
						<circle cx="116" cy="116" r="5" fill="#F5DCE5" opacity="0.85"></circle>
						<circle cx="164" cy="116" r="5" fill="#F5DCE5" opacity="0.85"></circle>
						<path d="M96 168c18 18 70 18 88 0" stroke="#E9E1F3" stroke-width="8" stroke-linecap="round"></path>
					</svg>
				</div>
			</section>

			<section class="latest">
				<div class="section-heading">
					<h2>最新文章</h2>
					<p class="section-en">LATEST NOTES</p>
				</div>
				<ul class="post-grid">
					{
						posts.map((post) => (
							<li>
								<a class="post-card" href={`/blog/${post.id}/`}>
									<div class="card-cover">
										{post.data.heroImage ? (
											<img src={post.data.heroImage} alt="" width="640" height="360" />
										) : (
											<div class="card-cover-fallback"></div>
										)}
									</div>
									<div class="card-body">
										<h3>{post.data.title}</h3>
										<p class="card-desc">{post.data.description}</p>
										<p class="card-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 1080px;
		max-width: calc(100% - 2em);
		padding-top: 2.4rem;
		padding-bottom: 4rem;
	}

	.hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 2rem;
		align-items: center;
		padding: 2rem 2.1rem;
		background: var(--card);
		border-radius: 28px;
		box-shadow: var(--box-shadow);
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: auto -40px -50px auto;
		width: 220px;
		height: 220px;
		background: radial-gradient(circle, var(--lilac) 0%, transparent 70%);
		pointer-events: none;
	}

	.hero-copy h1 {
		margin: 0;
		font-size: 2.15rem;
		line-height: 1.35;
		color: var(--coffee);
	}

	.hero-en {
		margin: 0.55rem 0 1.15rem;
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.hero-intro {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.8;
		max-width: 28rem;
	}

	.hero-assist {
		margin: 0.4rem 0 0;
		font-size: 0.82rem;
		color: var(--muted);
	}

	.hero-art {
		position: relative;
		min-height: 240px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(160deg, #f5dce5 0%, #fffdf9 48%, #e9e1f3 100%);
		border-radius: 24px;
	}

	.hero-illustration {
		width: min(280px, 100%);
		height: auto;
		position: relative;
		z-index: 1;
	}

	.petal {
		position: absolute;
		width: 14px;
		height: 18px;
		background: #f5dce5;
		border-radius: 70% 10% 70% 10%;
		opacity: 0.9;
	}

	.petal-one {
		top: 18px;
		left: 22px;
		transform: rotate(18deg);
	}

	.petal-two {
		top: 42px;
		right: 28px;
		background: #e9e1f3;
		transform: rotate(-24deg);
	}

	.petal-three {
		bottom: 28px;
		left: 42px;
		transform: rotate(40deg);
	}

	.latest {
		margin-top: 3.2rem;
	}

	.section-heading {
		margin-bottom: 1.4rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.7rem;
		color: var(--coffee);
	}

	.section-en {
		margin: 0.3rem 0 0;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		background: var(--card);
		border-radius: 22px;
		box-shadow: var(--box-shadow);
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 14px 28px rgba(98, 84, 79, 0.12);
		color: inherit;
	}

	.card-cover,
	.card-cover img,
	.card-cover-fallback {
		width: 100%;
		height: 180px;
		object-fit: cover;
		border-radius: 0;
		background: linear-gradient(135deg, #f5dce5, #e9e1f3 55%, #fffdf9);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.15rem 1.25rem;
	}

	.card-body h3 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.4;
		color: var(--coffee);
	}

	.card-desc {
		margin: 0.15rem 0 0.35rem;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--coffee);
	}

	.card-date {
		margin: 0;
		font-size: 0.82rem;
		color: var(--muted);
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 1.5rem 1.25rem 1.4rem;
		}

		.hero-copy h1 {
			font-size: 1.7rem;
		}

		.post-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.home {
			padding-top: 1.4rem;
		}

		.hero-art {
			min-height: 200px;
		}
	}
</style>
