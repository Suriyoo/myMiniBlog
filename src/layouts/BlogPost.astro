---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostCard from '../components/PostCard.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	previousPost?: CollectionEntry<'blog'>;
	nextPost?: CollectionEntry<'blog'>;
	relatedPosts?: CollectionEntry<'blog'>[];
};

const {
	title,
	titleEn,
	description,
	descriptionEn,
	pubDate,
	updatedDate,
	heroImage,
	previousPost,
	nextPost,
	relatedPosts = [],
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead
			title={titleEn ? `${title} | ${titleEn}` : title}
			description={descriptionEn ? `${description} ${descriptionEn}` : description}
		/>
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}
			.reading-progress {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 40;
				width: 100%;
				height: 3px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left center;
				will-change: transform;
			}
			.hero-image {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto var(--space-5);
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-control);
				box-shadow: var(--box-shadow);
			}
			.article-layout {
				display: grid;
				grid-template-columns: minmax(0, var(--content-width)) 220px;
				box-sizing: border-box;
				gap: var(--space-12);
				justify-content: center;
				width: 100%;
				max-width: 1180px;
				margin: 0 auto;
				padding: 0 var(--space-5);
				align-items: start;
			}
			.article-main {
				min-width: 0;
			}
			.prose {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: var(--space-4) 0;
				color: var(--text-primary);
			}
			.article-content {
				min-width: 0;
				line-height: var(--line-height-reading);
			}
			:global(.article-content h2),
			:global(.article-content h3) {
				scroll-margin-top: 6rem;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0;
				font-size: var(--font-size-article-title);
				line-height: 1.25;
			}
			.title-en {
				margin: 0.25rem 0 0.75rem;
				font-size: 1.05rem;
				line-height: 1.5;
				color: var(--text-english);
			}
			.description {
				margin: 0.75rem 0 0.2rem;
				font-size: 0.95rem;
				line-height: 1.65;
				color: var(--text-primary);
			}
			.description-en {
				margin: 0.15rem 0 0;
				font-size: calc(1em - 2px);
				line-height: 1.6;
				color: var(--text-english);
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--text-secondary);
			}
			.last-updated-on {
				font-style: italic;
			}
			:global(.prose h2) {
				font-size: var(--font-size-section);
				font-weight: var(--font-weight-semibold);
				line-height: 1.3;
				color: var(--text-primary);
			}
			:global(.prose h3) {
				font-size: 24px;
			}
			:global(.prose .section-heading) {
				margin: 2rem 0 1.5rem;
				padding-left: 1rem;
				border-left: 2px solid rgba(var(--accent-rgb), 0.58);
				border-radius: 3px;
			}
			:global(.prose .section-heading h2) {
				margin: 0;
			}
			:global(.prose .section-heading .section-translation) {
				margin: var(--space-2) 0 0;
				font-size: 16px;
				font-weight: var(--font-weight-medium);
				line-height: 1.4;
				color: var(--text-english);
			}
			:global(.prose p.translation) {
				margin: 0 0 var(--space-6);
				font-size: calc(1em - 2px);
				line-height: 1.6;
				color: var(--text-english);
			}
			:global(.prose p:has(+ p.translation)) {
				margin-bottom: var(--space-2);
			}
			:global(.prose li > p.translation) {
				display: block;
				position: static;
				max-width: 100%;
				margin: 0.35rem 0 0.65rem;
				font-size: calc(1em - 2px);
				line-height: 1.6;
				overflow-wrap: anywhere;
			}
			.toc-sidebar {
				position: sticky;
				top: 6rem;
				align-self: start;
				max-height: calc(100vh - 7rem);
				overflow-y: auto;
				box-sizing: border-box;
				padding: 1.5rem;
				background: var(--surface);
				border: 1px solid var(--divider);
				border-radius: 0 0 18px 18px;
			}
			.toc-title {
				margin: 0 0 1.25rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--divider);
				color: var(--text-primary);
				font-size: var(--font-size-small);
				font-weight: var(--font-weight-semibold);
				letter-spacing: 0.04em;
			}
			.toc-title-en {
				display: none;
			}
			:global(aside.toc-sidebar nav[data-toc="desktop"] ol),
			:global(details.toc-mobile nav[data-toc="mobile"] ol) {
				list-style: none !important;
				list-style-type: none !important;
				margin: 0;
				padding: 0;
				counter-reset: none;
			}
			:global(aside.toc-sidebar nav[data-toc="desktop"] li),
			:global(details.toc-mobile nav[data-toc="mobile"] li) {
				display: flex;
				align-items: baseline;
				gap: 0.65rem;
				list-style: none !important;
				margin: 0;
				padding: 0;
			}
			:global(aside.toc-sidebar nav[data-toc="desktop"] li::marker),
			:global(details.toc-mobile nav[data-toc="mobile"] li::marker) {
				content: "" !important;
			}
			:global(aside.toc-sidebar nav[data-toc="desktop"] li + li),
			:global(details.toc-mobile nav[data-toc="mobile"] li + li) {
				margin-top: 0.8rem;
			}
			:global(aside.toc-sidebar .toc-number),
			:global(details.toc-mobile .toc-number) {
				flex: 0 0 1.55rem;
				color: var(--text-secondary);
				font-size: 0.82rem;
				line-height: 1.5;
				font-variant-numeric: tabular-nums;
			}
			:global(aside.toc-sidebar nav[data-toc="desktop"] a),
			:global(details.toc-mobile nav[data-toc="mobile"] a) {
				display: block;
				flex: 1;
				min-width: 0;
				color: var(--text-secondary);
				font-size: 0.88rem;
				line-height: 1.6;
				text-decoration: none !important;
				border-bottom: 0 !important;
				box-shadow: none !important;
				transition: color 160ms ease;
			}
			:global(aside.toc-sidebar nav[data-toc="desktop"] a:hover),
			:global(details.toc-mobile nav[data-toc="mobile"] a:hover) {
				color: var(--accent-dark);
			}
			:global(aside.toc-sidebar li.active .toc-number),
			:global(aside.toc-sidebar li.active a),
			:global(details.toc-mobile li.active .toc-number),
			:global(details.toc-mobile li.active a) {
				color: var(--accent-dark);
				font-weight: var(--font-weight-semibold);
			}
			:global(aside.toc-sidebar .toc-h3),
			:global(details.toc-mobile .toc-h3) {
				padding-left: 0.45rem;
			}
			:global(aside.toc-sidebar .toc-h3 .toc-number),
			:global(details.toc-mobile .toc-h3 .toc-number) {
				font-size: 0.76rem;
			}
			:global(aside.toc-sidebar .toc-h3 a),
			:global(details.toc-mobile .toc-h3 a) {
				font-size: 0.82rem;
			}
			.toc-mobile {
				display: none;
			}
			.back-to-blog {
				display: inline-flex;
				flex-wrap: wrap;
				gap: var(--space-2);
				margin: var(--space-4) 0 var(--space-6);
				color: var(--accent-dark);
				font-size: var(--font-size-small);
				text-decoration: none;
			}
			.back-to-blog span {
				color: var(--text-english);
				font-size: var(--font-size-caption);
			}
			.article-pagination {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: var(--space-5);
				padding: var(--space-5) 0;
				border-top: 1px solid var(--divider);
				border-bottom: 1px solid var(--divider);
			}
			.article-pagination > a {
				display: grid;
				gap: var(--space-1);
				color: var(--text-primary);
				text-decoration: none;
			}
			.article-pagination .next-post {
				text-align: right;
			}
			.article-pagination span {
				color: var(--text-english);
				font-size: var(--font-size-caption);
			}
			.article-pagination strong {
				font-size: var(--font-size-small);
			}
			.related-posts {
				margin-top: var(--space-8);
			}
			.related-posts .section-heading {
				margin-bottom: var(--space-4);
			}
			.related-posts .section-heading h2 {
				margin: 0;
				font-size: var(--font-size-card-title);
			}
			.related-posts .section-heading p {
				margin: var(--space-1) 0 0;
				color: var(--text-english);
				font-size: var(--font-size-caption);
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: var(--space-4);
				list-style: none;
				margin: 0;
				padding: 0;
			}
			@media (max-width: 1100px) {
				.article-layout {
					display: block;
					max-width: var(--content-width);
					margin: 0 auto;
					padding: 0 var(--space-4);
				}
				.toc-sidebar {
					display: none;
				}
				.toc-mobile {
					display: block;
					margin: 0 0 var(--space-6);
					padding: var(--space-3) 0;
					border-top: 1px solid var(--divider);
					border-bottom: 1px solid var(--divider);
				}
				.toc-mobile summary {
					color: var(--text-primary);
					font-size: var(--font-size-small);
					font-weight: var(--font-weight-semibold);
					cursor: pointer;
				}
				.toc-mobile summary span {
					margin-left: var(--space-2);
					color: var(--text-english);
					font-size: var(--font-size-caption);
					font-weight: 400;
				}
				.toc-mobile nav {
					margin-top: var(--space-3);
				}
			}
			@media (max-width: 720px) {
				:global(.prose h2) {
					font-size: var(--font-size-section-mobile);
				}
				:global(.prose h3) {
					font-size: 21px;
				}
				.title h1 {
					font-size: var(--font-size-article-title-mobile);
				}
				.title-en {
					font-size: 1rem;
				}
				:global(.prose .section-heading .section-translation) {
					font-size: 15px;
				}
				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<div class="reading-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="article-layout">
					<div class="article-main">
						<div class="prose">
							<div class="title">
								<div class="date">
									<FormattedDate date={pubDate} />
									{
										updatedDate && (
											<div class="last-updated-on">
												Last updated on <FormattedDate date={updatedDate} />
											</div>
										)
									}
								</div>
								<h1>{title}</h1>
								{titleEn && <p class="title-en">{titleEn}</p>}
								{description && <p class="description">{description}</p>}
								{descriptionEn && <p class="description-en">{descriptionEn}</p>}
								<hr />
							</div>
							<details class="toc-mobile">
								<summary>本文目录 <span>CONTENTS</span></summary>
								<nav data-toc="mobile" aria-label="文章目录"></nav>
							</details>
							<div class="article-content">
								<slot />
							</div>
							<a class="back-to-blog" href="/blog/">← 返回文章列表 <span>BACK TO BLOG</span></a>
							{
								(previousPost || nextPost) && (
									<nav class="article-pagination" aria-label="文章导航">
										{previousPost ? (
											<a href={`/blog/${previousPost.id}/`}>
												<span>上一篇 · PREVIOUS</span>
												<strong>{previousPost.data.title}</strong>
											</a>
										) : <span></span>}
										{nextPost ? (
											<a class="next-post" href={`/blog/${nextPost.id}/`}>
												<span>下一篇 · NEXT</span>
												<strong>{nextPost.data.title}</strong>
											</a>
										) : <span></span>}
									</nav>
								)
							}
							{relatedPosts.length > 0 && (
								<section class="related-posts" aria-labelledby="related-heading">
									<div class="section-heading">
										<h2 id="related-heading">继续阅读</h2>
										<p>RELATED STORIES</p>
									</div>
									<ul class="related-grid">
										{relatedPosts.map((relatedPost, index) => (
											<li><PostCard post={relatedPost} variant={index} headingLevel="h3" /></li>
										))}
									</ul>
								</section>
							)}
						</div>
					</div>
					<aside class="toc-sidebar" aria-label="文章目录">
						<p class="toc-title">ON THIS PAGE</p>
						<nav data-toc="desktop" aria-label="文章目录"></nav>
					</aside>
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const articleContent = document.querySelector<HTMLElement>('.article-content');
			const headings = Array.from(articleContent?.querySelectorAll<HTMLElement>('h2, h3') ?? []);
			const tocContainers = document.querySelectorAll<HTMLElement>('[data-toc]');
			const tocWrappers = [document.querySelector<HTMLElement>('.toc-sidebar'), document.querySelector<HTMLElement>('.toc-mobile')];

			if (headings.length === 0) {
				tocWrappers.forEach((wrapper) => {
					if (wrapper) wrapper.hidden = true;
				});
			} else {
				headings.forEach((heading, index) => {
					if (!heading.id) heading.id = `article-section-${index + 1}`;
				});

				tocContainers.forEach((container) => {
					const list = document.createElement('ol');
					headings.forEach((heading, index) => {
						const item = document.createElement('li');
						item.className = `toc-${heading.tagName.toLowerCase()}`;

						const number = document.createElement('span');
						number.className = 'toc-number';
						number.textContent = String(index + 1).padStart(2, '0');

						const link = document.createElement('a');
						link.href = `#${heading.id}`;
						link.textContent = heading.textContent?.trim() ?? '';

						item.append(number, link);
						list.append(item);
					});
					container.replaceChildren(list);
				});

				const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc] li a');
				const headingObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const activeId = (entry.target as HTMLElement).id;
							tocLinks.forEach((link) => {
								const item = link.closest('li');
								const isActive = link.getAttribute('href') === `#${activeId}`;
								item?.classList.toggle('active', isActive);
							});
						});
					},
					{ rootMargin: '-15% 0px -75% 0px' },
				);

				headings.forEach((heading) => headingObserver.observe(heading));
			}

			const mobileToc = document.querySelector<HTMLDetailsElement>('.toc-mobile');
			mobileToc?.querySelector('nav')?.addEventListener('click', (event) => {
				if ((event.target as HTMLElement).closest('a')) mobileToc.open = false;
			});

			const progressBar = document.querySelector<HTMLElement>('.reading-progress');
			const updateReadingProgress = () => {
				if (!progressBar) return;
				const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
				const progress = scrollableHeight > 0 ? Math.min(window.scrollY / scrollableHeight, 1) : 0;
				progressBar.style.transform = `scaleX(${progress})`;
				progressBar.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
			};

			window.addEventListener('scroll', updateReadingProgress, { passive: true });
			window.addEventListener('resize', updateReadingProgress);
			updateReadingProgress();
		</script>
	</body>
</html>
