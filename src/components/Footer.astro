---
const today = new Date();
---

<footer class="site-footer">
	<p class="footer-brand">Mintsweet ♡</p>
	<p class="footer-tagline-zh">记录生活，收藏美好。</p>
	<p class="footer-tagline-en">Little moments, lovely memories.</p>
	<p class="footer-copy">&copy; {today.getFullYear()} Mintsweet. All rights reserved.</p>
</footer>
<style>
	.site-footer {
		padding: 2.5rem 1.25rem 3.5rem;
		background: linear-gradient(180deg, transparent 0%, #f5dce5 48%, #e9e1f3 100%);
		color: var(--muted);
		text-align: center;
	}

	.footer-brand {
		margin: 0 0 0.35rem;
		color: var(--coffee);
		font-size: 1.15rem;
		font-weight: 700;
	}

	.footer-tagline-zh {
		margin: 0;
		color: var(--coffee);
		font-size: 0.98rem;
	}

	.footer-tagline-en {
		margin: 0.2rem 0 1rem;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.footer-copy {
		margin: 0;
		font-size: 0.82rem;
	}
</style>
