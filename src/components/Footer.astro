---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { profile } from '../data/profile';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-main">
		<div class="footer-branding">
			<a class="footer-brand" href="/">{SITE_TITLE}</a>
			<p class="footer-tagline-zh">{SITE_DESCRIPTION}</p>
			<p class="footer-tagline-en">Personal notes, ideas, and stories.</p>
		</div>
		<nav class="footer-nav" aria-label="页脚导航">
			<h2>浏览 <span>EXPLORE</span></h2>
			<a href="/">首页 <span>HOME</span></a>
			<a href="/blog/">文章 <span>BLOG</span></a>
			<a href="/about/">关于我 <span>ABOUT</span></a>
			<a href="/rss.xml">RSS</a>
		</nav>
		<div class="footer-contact">
			<h2>联系 <span>CONNECT</span></h2>
			{
				profile.contact.email ? (
					<a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
				) : (
					<p>邮箱待填写。</p>
				)
			}
			{profile.contact.socialLinks.length > 0 ? (
				profile.contact.socialLinks.map((link) => (
					<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
				))
			) : (
				<p>公开社交链接待填写。</p>
			)}
		</div>
		<a class="back-to-top" href="#top">返回顶部 <span aria-hidden="true">↑</span></a>
	</div>
	<div class="footer-bottom">
		<p class="footer-copy">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>
<style>
	.site-footer {
		padding: var(--space-8) var(--space-5) var(--space-5);
		background: var(--surface);
		border-top: 1px solid var(--divider);
		color: var(--text-secondary);
	}

	.footer-main {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(120px, 0.6fr) minmax(180px, 0.8fr) auto;
		align-items: start;
		gap: var(--space-8);
		width: var(--site-width);
		max-width: 100%;
		margin: 0 auto;
	}

	.footer-brand {
		display: inline-block;
		margin: 0 0 var(--space-2);
		color: var(--text-primary);
		font-size: var(--font-size-card-title);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}

	.footer-tagline-zh {
		max-width: 24rem;
		margin: 0 0 var(--space-1);
		color: var(--text-secondary);
		font-size: var(--font-size-small);
	}

	.footer-tagline-en {
		margin: 0;
		color: var(--text-english);
		font-size: var(--font-size-caption);
	}

	.footer-nav,
	.footer-contact {
		display: grid;
		justify-items: start;
		gap: var(--space-2);
	}

	.footer-nav h2,
	.footer-contact h2 {
		margin: 0 0 var(--space-1);
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
	}

	.footer-nav h2 span,
	.footer-contact h2 span,
	.footer-nav a span {
		margin-left: var(--space-1);
		color: var(--text-english);
		font-size: var(--font-size-caption);
		font-weight: 400;
	}

	.footer-nav a,
	.footer-contact a {
		color: var(--text-secondary);
		font-size: var(--font-size-small);
		text-decoration: none;
	}

	.footer-nav a:hover,
	.footer-contact a:hover,
	.footer-brand:hover {
		color: var(--accent-dark);
	}

	.footer-contact p {
		margin: 0;
		color: var(--text-secondary);
		font-size: var(--font-size-small);
	}

	.back-to-top {
		color: var(--accent-dark);
		font-size: var(--font-size-small);
		text-decoration: none;
		white-space: nowrap;
	}

	.back-to-top span {
		margin-left: var(--space-1);
	}

	.footer-bottom {
		width: var(--site-width);
		max-width: 100%;
		margin: var(--space-8) auto 0;
		padding-top: var(--space-4);
		border-top: 1px solid var(--divider);
	}

	.footer-copy {
		margin: 0;
		color: var(--text-secondary);
		font-size: var(--font-size-caption);
	}

	@media (max-width: 820px) {
		.footer-main {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.site-footer {
			padding-inline: var(--space-4);
		}

		.footer-main {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}

		.back-to-top {
			justify-self: start;
		}
	}
</style>
